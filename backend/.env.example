# Google Gemini API Key (Optional: system has full built-in offline NLP engine fallback)
GEMINI_API_KEY=

# Server configuration
PORT=8000
DEBUG=True

# Authentication & Security Secrets
JWT_SECRET_KEY=your_jwt_secret_key_change_in_production
JWT_ACCESS_TOKEN_EXPIRE_HOURS=24
JWT_REMEMBER_ME_EXPIRE_DAYS=30

# MongoDB Configuration (Optional - SQLite is used by default)
MONGODB_URL=
MONGODB_DB_NAME=learning_system
